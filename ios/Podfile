platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Inbound-share Share Extension (ios/ShareExtension) has NO CocoaPods
# integration on purpose. It is not a Flutter target, so it cannot resolve the
# Flutter engine framework that receive_sharing_intent's ObjC umbrella imports
# (<Flutter/Flutter.h>) — every attempt to link the pod into the extension
# failed to build the module. Instead the extension VENDORS the Flutter-free
# pieces it needs (RSIShareViewController.swift + SharedMedia.swift, copied from
# receive_sharing_intent 1.8.1) directly into its file-system-synchronized
# source folder, so they compile into the .appex with zero Flutter dependency.
# The receive_sharing_intent pod stays on Runner only, for the Dart plugin side.
# Hence there is intentionally no `target 'ShareExtension'` block here.

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  # Hindi/Devanagari OCR for Shiv's image search — google_mlkit_text_recognition
  # pulls only the Latin recogniser. Version tracks the plugin's GoogleMLKit pin.
  pod 'GoogleMLKit/TextRecognitionDevanagari', '~> 9.0.0'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Isar device-link fix.
# isar_community_flutter_libs ships a *static* libisar.a whose C API symbols
# (isar_version, isar_open, ...) are only reached at runtime via dlsym. Under
# `use_frameworks! :linkage => :static` + release Dead Code Stripping the linker
# drops those never-statically-referenced objects, so on a physical device
# Isar.open() throws "Could not initialize IsarCore library ... symbol not
# found". (It also collides with MediaPipe over Rust's `_rust_eh_personality`.)
#
# Fix (per isar issue #1072): build *only* isar as a dynamic framework. As its
# own dynamic image its exports survive stripping (dlsym finds them) and its
# Rust runtime symbols stay inside the isar dylib, so they never clash with
# MediaPipe in the app binary.
isar_dynamic_framework = ['isar_community_flutter_libs']

pre_install do |installer|
  # xcodeproj objectVersion 70 shim.
  # Xcode 26 writes `objectVersion = 70` into Runner.xcodeproj (it converts
  # folders to file-system-synchronized groups). CocoaPods builds the Pods
  # project at that same objectVersion, but the bundled xcodeproj 1.27.0 map
  # (COMPATIBILITY_VERSION_BY_OBJECT_VERSION) jumps 63 → 77 with no 70, so
  # `Xcodeproj::Project.new(..., 70)` raises "Unable to find compatibility
  # version string for object version `70`" and `pod install` dies. pre_install
  # runs before Pods-project generation, so inject the missing entry here. Kept
  # in the Podfile (not a local gem patch) so teammates / CI on CocoaPods
  # ≤1.16.2 don't hit the same crash. Remove once the bundled xcodeproj maps 70.
  require 'xcodeproj'
  unless Xcodeproj::Constants::COMPATIBILITY_VERSION_BY_OBJECT_VERSION.key?(70)
    patched = Xcodeproj::Constants::COMPATIBILITY_VERSION_BY_OBJECT_VERSION
                .merge(70 => 'Xcode 16.0').freeze
    Xcodeproj::Constants.send(:remove_const, :COMPATIBILITY_VERSION_BY_OBJECT_VERSION)
    Xcodeproj::Constants.const_set(:COMPATIBILITY_VERSION_BY_OBJECT_VERSION, patched)
  end

  # Allow a single dynamic framework among otherwise-static pods.
  Pod::Installer::Xcode::TargetValidator.send(:define_method, :verify_no_static_framework_transitive_dependencies) {}
  installer.pod_targets.each do |pod|
    next unless isar_dynamic_framework.include?(pod.name)
    def pod.dynamic_framework; true; end
    def pod.build_type; Pod::BuildType.dynamic_framework; end
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    end

    # file_picker ships an *unprefixed* ObjC class `FileUtils` (statically linked
    # into Runner.debug.dylib). It collides with Apple's private OSAnalytics.framework
    # `FileUtils`, which loads under the `flutter run`/debug launch path — the objc
    # runtime then keeps only one implementation and a retain on the wrong-layout
    # instance faults (cold-start EXC_BAD_ACCESS, main thread). All file_picker
    # references are compile-time symbols (no NSClassFromString), so a scoped
    # preprocessor define renames the class declaration, implementation, and every
    # call site consistently; `#import "FileUtils.h"` filenames are string literals
    # and stay untouched. No system header file_picker imports has a `FileUtils` token.
    if target.name == 'file_picker'
      target.build_configurations.each do |config|
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FileUtils=FPFileUtils'
      end
    end
  end
end
